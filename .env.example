# Kopieren nach .env und Werte eintragen. .env wird nicht committet.

# LLM über das LiteLLM-Gateway des Moduls (SW4/SW5)
# API_KEY: persönlicher Key aus LiteLLM (Login über den FHNW-Einladungslink). Nie committen.
# MODEL: Namen anzeigen mit  python -m agent.check_gateway --models
MODEL=
BASE_URL=https://litellm.engines.aisl.science
API_KEY=

# Tracing (SW5)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=gastroplanner

# 1 = Agent nutzt tests/fixtures/*.json statt der echten Funktionen von A und Helin.
# Auf 0 stellen, sobald forecast/, planning/ und tools/ fertig sind.
USE_FIXTURES=1
