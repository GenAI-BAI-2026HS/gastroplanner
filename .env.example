# Kopieren nach .env und Werte eintragen. .env wird nicht committet.

# LLM über das LiteLLM-Gateway des Moduls (SW4/SW5)
# API_KEY: persönlicher Key aus LiteLLM (Login über den FHNW-Einladungslink). Nie committen.
# MODEL: Namen anzeigen mit  python -m agent.check_gateway --models
MODEL=
BASE_URL=https://litellm.engines.aisl.science
API_KEY=

# Tracing (SW5)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=gastroplanner

# 0 = echte Funktionen (Prognose, Wetter, Kalender, Besetzung, Regelsuche, Memory).
# 1 = Beispieldaten aus tests/fixtures/ (Woche ab 26.10.2026), z. B. ohne Internet.
USE_FIXTURES=0

# 0 = Wetter und Kalender direkt statt über den MCP-Server aufrufen (nur falls MCP im
# Deployment nicht startet). Standard 1.
USE_MCP=1
